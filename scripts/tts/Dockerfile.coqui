# Image `language-tts-coqui` for synth_nos.py (Proxecto Nós Galician voices).
# Built automatically by generate.sh / say.sh. CPU-only PyTorch keeps the image small.
FROM python:3.12
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -q torch torchaudio --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -q "coqui-tts[codec]" six onnxruntime
